# Copy this file to .env and fill in real values. Never commit .env.
# See PLAN.md Phase 0 for where each of these comes from.

# Postgres connection string from Neon (https://neon.tech).
# Create a free project, then copy the "pooled connection" string it gives you.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# YouTube Data API v3 key from a Google Cloud project
# (console.cloud.google.com -> APIs & Services -> Credentials).
# Restrict it to the YouTube Data API v3 for safety.
YOUTUBE_API_KEY=""

# bcrypt hash of the admin password (not the plaintext password).
# Generate with: npx bcrypt-cli "your-chosen-password" 10
# or: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "your-chosen-password"
ADMIN_PASSWORD_HASH=""

# Random secret used to sign the admin session cookie (iron-session).
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Random secret that authorizes the hourly refresh cron (see vercel.json + app/api/refresh).
# Generate with: openssl rand -base64 32
# Set this as an env var on the Vercel project too — Vercel Cron automatically sends it as
# `Authorization: Bearer <CRON_SECRET>`, which is what stops the public endpoint from being
# triggered by anyone else.
CRON_SECRET=""

# Anthropic API key (console.anthropic.com) — powers the auto-classifier that sorts videos
# from mixed-content channels into the right topic. Only used during refresh, and only for
# sources flagged multi-topic; single-topic channels never call it.
ANTHROPIC_API_KEY=""
